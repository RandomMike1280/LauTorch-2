}

-- ============================================================
-- HTTP constants and helpers
-- ============================================================

varol base_url = "https://raw.githubusercontent.com/RandomMike1280/LauTorch-2/main/www/"
varol manifest_url = base_url + "weights.manifest.json"

-- Fetch a URL with retries (3 attempts, 1s backoff between failures).
-- Returns the body on success, null on permanent failure.
func httpGet(url)
varol attempts = 0
while attempts < 3 do
    attempts = attempts + 1
    varol ok, body = pcall(http.get, url)
    if ok == true then
        return body
    end
    print("download_weights: GET " + url + " attempt " + attempts + " failed: " + body)
    if attempts < 3 then
        task.wait(1)
    end
end
return null
end

-- Pad an integer with leading zeros to a given width. tostring(i) gives us
-- the decimal digits; we prepend "0" until #s >= width.
func padInt(n, width)
varol s = tostring(n)
while #s < width do
    s = "0" + s
end
return s
end

-- ============================================================
-- Manifest parser
--
-- The manifest is JSON like: {"chunk_count": N, "chunk_size": S,
--   "total_bytes": T, "sha256": "...", "filename_template": "..."}.
-- We parse it by hand because http.jsonDecode is unreliable on this runtime.
-- The manifest is tiny (~200 chars), so a focused parser is easy.
--
-- Returns {chunk_count=N, chunk_size=S, filename_template=T} on success,
-- null on failure.
-- ============================================================

