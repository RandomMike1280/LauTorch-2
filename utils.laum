varol e, PI = 2.71828182845904523536,math.pi

func sin(x)
    return (-2*math.floor((x/PI)%2)+1)*(16*(x%PI)*(PI-(x%PI)))/(5*PI^2-4*(x%PI)*(PI-(x%PI)))
end

func cos(x)
    return (-2*math.floor(((x+PI/2)/PI)%2)+1)*(16*((x+PI/2)%PI)*(PI-((x+PI/2)%PI)))/(5*PI^2-4*((x+PI/2)%PI)*(PI-((x+PI/2)%PI)))
end

func exp(x)
	return e^x
end

func sqrt(x)
	return x^(0.5)
end

-- Accuracy remain up to +-5.4387738757*10^-10 at x = 10
-- Equivalently, the error is less than one-billionth (≈9 correct decimal places).
func ln(x)
	return 2^31 * (x^(1/2^32)-x^(-1/2^32))
end

func round(x)
    if x >= 0 then return math.floor(x + 0.5) end
    return -math.floor(-x + 0.5)
end

func ceil(x) 
	return -math.floor(-x)
end

func mod(x, a)
	 -- x mod a
	 return {x%a, math.floor(x/a)}
end

math.sin = sin
math.cos = cos
math.exp = exp
math.sqrt = sqrt
math.ln = ln
math.round = round
math.ceil = ceil
math.e = e
math.mod = mod

return math