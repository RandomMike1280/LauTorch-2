--@cost(t=0)
varol url = "https://raw.githubusercontent.com/RandomMike1280/LauTorch-2/main/www/weights.json"

varol success, response = pcall(http.get, url)
if success ~= true then
    print("download_weights: HTTP request failed: " + response)
    return null
end

varol data = http.jsonDecode(response)

-- Embed vocab_chars directly since weights.json doesn't include them
data.vocab_chars = {
    " ",
    "!",
    "\"",
    "#",
    "$",
    "%",
    "&",
    "'",
    "(",
