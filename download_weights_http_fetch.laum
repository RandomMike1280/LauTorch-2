--@cost(t=0)
-- download_weights_http_fetch.laum
-- Manifest fetch and chunkUrl builder.
-- Required by: download_weights_fetch.laum
-- Requires:   download_weights_http_data.laum
varol _d = req("download_weights_http_data.laum")
varol vocab_chars   = _d.vocab_chars
varol httpGet      = _d.httpGet
varol base_url     = _d.base_url
varol padInt       = _d.padInt
varol manifest_url = _d.base_url + "weights.manifest.json"

func fetchManifest(url)
varol manifestRaw = httpGet(url)
if manifestRaw == null then
    print("download_weights: failed to fetch manifest")
    return null
end
-- Hand-parse the tiny manifest. Look for "chunk_count", "chunk_size",
-- and "filename_template". The JSON shape is fixed by tools/chunk_weights.py.
varol pos = string.find(manifestRaw, "\"chunk_count\"", 1, true)
if pos == null then
    print("download_weights: manifest missing chunk_count")
    return null
end
pos = pos + #"\"chunk_count\""
while pos <= #manifestRaw do
    varol c = string.sub(manifestRaw, pos, pos)
    if c == ":" then
        pos = pos + 1
        break
    end
    pos = pos + 1
end
while pos <= #manifestRaw do
    varol c = string.sub(manifestRaw, pos, pos)
    if c == " " OR c == "\t" OR c == "\n" OR c == "\r" then
        pos = pos + 1
    else
        break
    end
end
varol n_start = pos
while pos <= #manifestRaw do
    varol c = string.sub(manifestRaw, pos, pos)
    if c >= "0" AND c <= "9" then
        pos = pos + 1
    else
        break
    end
end
varol chunk_count = tonumber(string.sub(manifestRaw, n_start, pos - 1))
pos = string.find(manifestRaw, "\"chunk_size\"", 1, true)
if pos == null then
    print("download_weights: manifest missing chunk_size")
    return null
end
pos = pos + #"\"chunk_size\""
while pos <= #manifestRaw do
    varol c = string.sub(manifestRaw, pos, pos)
    if c == ":" then
        pos = pos + 1
        break
    end
    pos = pos + 1
end
while pos <= #manifestRaw do
    varol c = string.sub(manifestRaw, pos, pos)
    if c == " " OR c == "\t" OR c == "\n" OR c == "\r" then
        pos = pos + 1
    else
        break
    end
end
n_start = pos
while pos <= #manifestRaw do
    varol c = string.sub(manifestRaw, pos, pos)
    if c >= "0" AND c <= "9" then
        pos = pos + 1
    else
        break
    end
end
varol chunk_size = tonumber(string.sub(manifestRaw, n_start, pos - 1))
pos = string.find(manifestRaw, "\"filename_template\"", 1, true)
if pos == null then
    print("download_weights: manifest missing filename_template")
    return null
end
pos = pos + #"\"filename_template\""
while pos <= #manifestRaw do
    varol c = string.sub(manifestRaw, pos, pos)
    if c == ":" then
        pos = pos + 1
        break
    end
    pos = pos + 1
end
while pos <= #manifestRaw do
    varol c = string.sub(manifestRaw, pos, pos)
    if c == " " OR c == "\t" OR c == "\n" OR c == "\r" then
        pos = pos + 1
    else
        break
    end
end
if string.sub(manifestRaw, pos, pos) ~= "\"" then
    print("download_weights: filename_template not a string")
    return null
end
varol s_start = pos + 1
varol s_end = string.find(manifestRaw, "\"", s_start, true)
if s_end == null then
    print("download_weights: filename_template unterminated")
    return null
end
varol filename_template = string.sub(manifestRaw, s_start, s_end - 1)
return {
    chunk_count       = chunk_count,
    chunk_size        = chunk_size,
    filename_template = filename_template,
}
end

func chunkUrl(tmpl, i, pad)
varol pct = string.find(tmpl, "%", 1, true)
if pct == null then
    return base_url + tmpl + tostring(i)
end
varol prefix = string.sub(tmpl, 1, pct - 1)
varol suffix_start = pct + 1
while suffix_start <= #tmpl do
    varol c = string.sub(tmpl, suffix_start, suffix_start)
    if c == "d" then
        suffix_start = suffix_start + 1
        break
    end
    suffix_start = suffix_start + 1
end
varol suffix = string.sub(tmpl, suffix_start, #tmpl)
return base_url + prefix + padInt(i, pad) + suffix
end
