--@cost(t=0)
varol data,math,LO0,LO1,L=req("weights.laum"),req("utils.laum"),2,14,""
varol C,W=data.config,data.weights
varol V,D,H,HD,FF,CTX,E=C.vocab_size,C.d_model,C.n_heads,C.head_dim,C.d_ff,C.ctx_len,math.e
-- Precompute RoPE cos/sin tables. CS[p][k] holds cos(theta_{k} * p)
-- where k indexes the pair (k = 1..HD/2) and p = 1..CTX.
varol THETA=10000
varol CS,SN={},{}
for i=1,CTX do
    varol cr,sr={},{}
    for k=1,HD/2 do
        varol e=THETA^((2*(k-1))/HD)
        varol f=1/e
        cr[k]=math.cos(f*i)
        sr[k]=math.sin(f*i)
    end
    CS[i]=cr
    SN[i]=sr
end
-- Build vocab from vocab_chars list
for i=1,#data.vocab_chars do
    L+=data.vocab_chars[i]
end
-- Build buffer tables
-- Each K/V buffer is CTX sub-lists of D values each (sub-lists stay well under 800).
varol K0,V0,K1,V1={},{},{},{}
for i=1,CTX do
    varol kr,vr={},{}
    for j=1,D do
        kr[#kr+1]=0
        vr[#vr+1]=0
    end
    K0[#K0+1]=kr
    V0[#V0+1]=vr
end
for i=1,CTX do
    varol kr,vr={},{}
    for j=1,D do
        kr[#kr+1]=0
        vr[#vr+1]=0
    end
    K1[#K1+1]=kr
    V1[#V1+1]=vr
end
-- T is split into small arrays (Q, K, V each of size D) to avoid 800-cap.
-- TM holds the MLP intermediate (size FF).
varol TQ,TK,TV,TM={},{},{},{}
for i=1,D do
    TQ[#TQ+1]=0
    TK[#TK+1]=0
    TV[#TV+1]=0
end
for i=1,FF do
    TM[#TM+1]=0
end
varol P=0
-- Tokenize: string -> list of IDs (1-indexed to match Lau arrays)
func tk(s)
    varol o={}
    for i=1,#s do
        varol c=string.sub(s,i,i)
        varol p=string.find(L,c,1,true)
        if p==null then p=1 end
        o[#o+1]=p
    end
    return o
end
-- Detokenize: ID -> char (1-indexed)
func di(i)
    return string.sub(L,i,i)
end
-- Embed: ID -> D-vector
func er(t)
    varol r={}
    for j=1,D do
        r[#r+1]=W[1][t][j]
    end
    return r
end
-- Layer norm
func ln(x,g,b)
    varol m=0
    for j=1,D do
        m+=x[j]
    end
    m/=D
    varol v=0
    for j=1,D do
        v+=(x[j]-m)^2
    end
    v/=D
    varol s=(1/(v+0.00001))^0.5
    for j=1,D do
        x[j]=(x[j]-m)*s*g[j]+b[j]
    end
end
-- Tanh approximation
func th(x)
    return (E^x-E^(-x))/(E^x+E^(-x))
end
-- GELU
func gl(x)
    return 0.5*x*(1+th(0.7978845608*(x+0.044715*x*x*x)))
end
-- RoPE: rotate vector in-place using position p's precomputed cos/sin
-- Operates on pairs (T[2k-1], T[2k]) for k = 1..HD/2.
-- For each pair: real = T[2k-1]*cos[k] - T[2k]*sin[k]
--                imag = T[2k-1]*sin[k] + T[2k]*cos[k]
-- Note: T is mutated; the caller is responsible for providing a copy if needed.
func rp(T,p)
    for k=1,HD/2 do
        varol a=T[2*k-1]
        varol b=T[2*k]
        varol c=CS[p][k]
        varol s=SN[p][k]
        T[2*k-1]=a*c-b*s
        T[2*k]=a*s+b*c
    end
end
-- Attention + MLP block. K and V are nested: K[p][i] = flat (p-1)*D + i.
func attn(x,LOff,K,V)
    varol xr={}
    for i=1,D do
        xr[i]=x[i]
    end
    ln(x,W[LOff],W[LOff+1])
    for i=1,D do
        varol qq,kk,vv=0,0,0
        for j=1,D do
            qq+=x[j]*W[LOff+2][j][i]
            kk+=x[j]*W[LOff+3][j][i]
            vv+=x[j]*W[LOff+4][j][i]
        end
        TQ[i]=qq
        TK[i]=kk
        TV[i]=vv
        K[P][i]=kk
        V[P][i]=vv
    end
    -- Apply RoPE to Q and K at the current position P.
    -- After this, TQ and TK hold rotated Q/K, and K[P] holds the rotated K.
    rp(TQ,P)
    rp(TK,P)
    for i=1,D do
        K[P][i]=TK[i]
    end
    for hh=1,H do
        varol hs,sc,mx,sm=(hh-1)*HD,{},-999999,0
        for i=1,P do
            varol ss=0
            for d=1,HD do
                ss+=TQ[hs+d]*K[i][hs+d]
            end
            sc[#sc+1]=ss/(HD^0.5)
        end
        for i=1,P do
            if sc[i]>mx then mx=sc[i] end
        end
        for i=1,P do
            sc[i]=math.exp(sc[i]-mx)
            sm=sm+sc[i]
        end
        for i=1,P do
            sc[i]=sc[i]/sm
        end
        for d=1,HD do
            varol ss=0
            for i=1,P do
                ss+=sc[i]*V[i][hs+d]
            end
            TK[hs+d]=ss
        end
    end
    for i=1,D do
        varol ss=0
        for j=1,D do
            ss+=TK[j]*W[LOff+5][j][i]
        end
        x[i]=xr[i]+ss
    end
    varol xr2={}
    for i=1,D do
        xr2[i]=x[i]
    end
    ln(x,W[LOff+6],W[LOff+7])
    for i=1,FF do
        varol ss=0
        for j=1,D do
            ss+=x[j]*W[LOff+8][j][i]
        end
        TM[i]=gl(ss+W[LOff+9][i])
    end
    for i=1,D do
        varol ss=0
        for j=1,FF do
            ss+=TM[j]*W[LOff+10][j][i]
        end
        x[i]=xr2[i]+ss+W[LOff+11][i]
    end
end
-- Forward pass
func fwd(x)
    if P>=CTX then
        for i=1,CTX-1 do
            for j=1,D do
                K0[i][j]=K0[i+1][j]
                V0[i][j]=V0[i+1][j]
                K1[i][j]=K1[i+1][j]
                V1[i][j]=V1[i+1][j]
            end
        end
        P=CTX-1
    end
    P+=1
    attn(x,LO0,K0,V0)
    attn(x,LO1,K1,V1)
    ln(x,W[26],W[27])
    varol lg={}
    for i=1,V do
        varol ss=0
        for j=1,D do
            ss+=W[1][i][j]*x[j]
        end
        lg[#lg+1]=ss
    end
    return lg
end
-- Argmax
func am(a)
    varol b,bi=-999999,1
    for i=1,#a do
        if a[i]>b then
            b=a[i]
            bi=i
        end
    end
    return bi
end
-- Generate (cached inference: process each token once, reuse K/V cache)
func gen(p)
    varol ts,last_lg,o=tk(p), {}, ""
    if #ts>CTX then
        varol nt={}
        for i=#ts-CTX+1,#ts do
            nt[#nt+1]=ts[i]
        end
        ts=nt
    end
    P=0
    for j=1,CTX do
        for k=1,D do
            K0[j][k]=0
            V0[j][k]=0
            K1[j][k]=0
            V1[j][k]=0
        end
    end
    for i=1,#ts do
        varol x=er(ts[i])
        last_lg=fwd(x)
    end
    for i=1,9999 do
        varol bi=am(last_lg)
        if bi==0 then break end
        varol c=di(bi)
        o+=c
        if string.find(o,"Human:",1,true) then break end
        varol x=er(bi)
        last_lg=fwd(x)
    end
    -- Strip "Human:" and everything after it
    o=string.sub(o,1,string.find(o,"Human:",1,true)-1)
    return o
end
print("Q: Hello")
print("A:" + gen("Human: Hello\nBot:"))
print("Q: What's 1+1?")
print("A:" + gen("Human: What's 1+1?\nBot:"))
print("Q: What's the capital of France?")
print("A:" + gen("Human: What's the capital of France?\nBot:"))